# Copiez ce fichier en .env et renseignez au moins APP_PASSWORD.
APP_PASSWORD=changez-moi-avec-une-phrase-longue
APP_USERNAME=famille
# true derrière votre reverse proxy HTTPS (par défaut). false uniquement pour un essai en HTTP simple,
# sinon le navigateur refuse le cookie de connexion sans message d'erreur.
COOKIE_SECURE=true
SESSION_DAYS=30
TZ=Europe/Paris
# Adresse(s) de votre reverse proxy (celles qui peuvent fournir X-Forwarded-For). « * » n'est sûr que si le port 8000 n'est pas publié.
# FORWARDED_ALLOW_IPS=172.18.0.5
# SEED_RECIPES=false      # ne pas charger la bibliothèque de départ
# BACKUP_KEEP=7
